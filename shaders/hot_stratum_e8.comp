#version 450
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable

// Workgroup size 64 matches optimal wave size on RTX 4050 (2x Wave32) and AMD (Wave64)
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint d_model;          // Embedding dimension (e.g. 1536)
    uint neuron_count;     // Number of neurons (e.g. 7616 or 8960)
    uint pass_id;          // 0 = DualRotor Gate+Up, 1 = E8 Down Matrix
    float layer_gamma;     // QuIP# layer restitution scale
    float beta;            // Input activation norm scale
    float gate_gamma;      // Isometric gate gamma
    float up_gamma;        // Isometric up gamma
    uint words_per_row;    // 32-bit words per row (d_model / 32, e.g. 48)
} pc;

// Binding 0: DualRotor Bitplanes: [bp0_gate, bp1_gate, bp0_up, bp1_up] as uint32 words
// Size: 4 * neuron_count * words_per_row uint32 words
layout(std430, binding = 0) readonly buffer BitplanesBuffer {
    uint bitplanes[];
};

// Binding 1: Continuous input vector and binarized signs
layout(std430, binding = 1) readonly buffer InputBuffer {
    float x_in[]; // [d_model]
};

// Binding 2: Intermediate hidden activations h_hidden [neuron_count]
layout(std430, binding = 2) buffer HiddenBuffer {
    float h_hidden[];
};

// Binding 3: E8 Gosset Lattice Down Weights: 1 byte per 2 weights
// Total bytes: neuron_count * (d_model / 2), accessed as uint32 words (4 bytes = 8 weights)
layout(std430, binding = 3) readonly buffer DownWeightsE8Buffer {
    uint down_e8_u32[];
};

// Binding 4: Output accumulation vector y [d_model]
layout(std430, binding = 4) buffer OutputBuffer {
    float y_out[];
};

// Binding 5: Scales buffer: [gate_scales (N), up_scales (N), down_scales (N)]
layout(std430, binding = 5) readonly buffer ScalesBuffer {
    float scales[];
};

// Binding 6: Binarized input signs bitmask [words_per_row]
layout(std430, binding = 6) readonly buffer InputSignsBuffer {
    uint x_signs_u32[];
};

shared uint s_mg0[64];
shared uint s_mg1[64];
shared uint s_mu0[64];
shared uint s_mu1[64];
shared vec2 s_down[64];

float silu(float x) {
    return x / (1.0 + exp(-x));
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint wpr = pc.words_per_row; // e.g. 48 for d_model=1536
    uint n_words = pc.neuron_count * wpr;

    // Header in cold_payload (64 bytes = 16 uint32 words):
    // word 4: gate_bp0_offset (bytes)
    // word 5: gate_bp1_offset (bytes)
    // word 6: up_bp0_offset (bytes)
    // word 7: up_bp1_offset (bytes)
    // word 8: down_weights_offset (bytes)
    // word 9: scales_offset (bytes)
    uint bp0_g_base = (bitplanes[4] / 4u);
    uint bp1_g_base = (bitplanes[5] / 4u);
    uint bp0_u_base = (bitplanes[6] / 4u);
    uint bp1_u_base = (bitplanes[7] / 4u);
    uint down_u32_base = (bitplanes[8] / 4u);
    uint scales_f32_base = (bitplanes[9] / 4u);

    if (pc.pass_id == 0) {
        // ====================================================================
        // PASS 0: DualRotor Bitwise POPCNT Projection for Gate and Up
        // Dispatched with neuron_count workgroups (1 workgroup per neuron)
        // ====================================================================
        uint idx = gl_WorkGroupID.x;
        if (idx >= pc.neuron_count) return;

        uint base_g0 = bp0_g_base + idx * wpr;
        uint base_g1 = bp1_g_base + idx * wpr;
        uint base_u0 = bp0_u_base + idx * wpr;
        uint base_u1 = bp1_u_base + idx * wpr;

        float acc_g0 = 0.0;
        float acc_g1 = 0.0;
        float acc_u0 = 0.0;
        float acc_u1 = 0.0;

        // Continuous-input DualRotor projection (Clifford 16-entry Nibble LUT mathematical equivalent)
        // Preserves full floating-point input amplitude hierarchy without sign-binarization loss
        for (uint w = tid; w < wpr; w += 64u) {
            uint wg0 = bitplanes[base_g0 + w];
            uint wg1 = bitplanes[base_g1 + w];
            uint wu0 = bitplanes[base_u0 + w];
            uint wu1 = bitplanes[base_u1 + w];
            uint base_dim = w * 32u;

            for (uint b = 0u; b < 32u; ++b) {
                float x_val = x_in[base_dim + b];
                float sg0 = ((wg0 >> b) & 1u) != 0u ? 1.0 : -1.0;
                float sg1 = ((wg1 >> b) & 1u) != 0u ? 1.0 : -1.0;
                float su0 = ((wu0 >> b) & 1u) != 0u ? 1.0 : -1.0;
                float su1 = ((wu1 >> b) & 1u) != 0u ? 1.0 : -1.0;

                acc_g0 += x_val * sg0;
                acc_g1 += x_val * sg1;
                acc_u0 += x_val * su0;
                acc_u1 += x_val * su1;
            }
        }

        s_down[tid] = vec2(acc_g0, acc_g1);
        s_mg0[tid] = floatBitsToUint(acc_u0);
        s_mg1[tid] = floatBitsToUint(acc_u1);
        barrier();

        // Parallel workgroup tree reduction in shared memory
        for (uint s = 32u; s > 0u; s >>= 1u) {
            if (tid < s) {
                s_down[tid] += s_down[tid + s];
                float u0_a = uintBitsToFloat(s_mg0[tid]) + uintBitsToFloat(s_mg0[tid + s]);
                float u1_a = uintBitsToFloat(s_mg1[tid]) + uintBitsToFloat(s_mg1[tid + s]);
                s_mg0[tid] = floatBitsToUint(u0_a);
                s_mg1[tid] = floatBitsToUint(u1_a);
            }
            barrier();
        }

        if (tid == 0u) {
            float alpha_g = scales[scales_f32_base + idx];
            float alpha_u = scales[scales_f32_base + pc.neuron_count + idx];

            float dot_g0 = s_down[0].x;
            float dot_g1 = s_down[0].y;
            float g_val = ((dot_g0 * alpha_g) + (dot_g1 * 0.5 * alpha_g)) * pc.gate_gamma;

            float dot_u0 = uintBitsToFloat(s_mg0[0]);
            float dot_u1 = uintBitsToFloat(s_mg1[0]);
            float u_val = ((dot_u0 * alpha_u) + (dot_u1 * 0.5 * alpha_u)) * pc.up_gamma;

            // Normalize energy across active 20% budget relative to full cold_count
            float budget_norm = 0.20 * pc.layer_gamma;
            h_hidden[idx] = silu(g_val) * u_val * budget_norm;
        }

    } else if (pc.pass_id == 1) {
        // ====================================================================
        // PASS 1: E8 Gosset Lattice Down Projection Accumulation
        // Dispatched with ceil(d_pairs / 16) workgroups
        // 16 column pairs per workgroup x 4 rows unrolled
        // ====================================================================
        uint d_pairs = pc.d_model / 2u;
        uint c = tid & 15u;
        uint r = tid >> 4u;
        uint p_idx = gl_WorkGroupID.x * 16u + c;

        vec2 acc = vec2(0.0, 0.0);

        if (p_idx < d_pairs) {
            uint u32_per_row = (d_pairs + 3u) / 4u; // 4 pairs (8 weights) per u32
            uint u32_col = p_idx / 4u;
            uint byte_sub = (p_idx % 4u) * 8u; // bit offset in uint32

            for (uint i = r; i < pc.neuron_count; i += 4u) {
                float hi = h_hidden[i];
                float s_down = scales[scales_f32_base + 2u * pc.neuron_count + i];
                float scaled_h = hi * s_down;

                uint packed_u32 = down_e8_u32[down_u32_base + i * u32_per_row + u32_col];
                uint b_val = (packed_u32 >> byte_sub) & 0xFFu;

                // Decode 4-bit nibbles back into 2D E8 lattice weights
                float w0 = float(b_val & 3u) - 1.5;
                float w1 = float((b_val >> 2u) & 3u) - 1.5;

                acc.x += w0 * scaled_h;
                acc.y += w1 * scaled_h;
            }
        }

        s_down[tid] = acc;
        barrier();

        if (tid < 32u) {
            s_down[tid] += s_down[tid + 32u];
        }
        barrier();

        if (tid < 16u && p_idx < d_pairs) {
            vec2 total = s_down[tid] + s_down[tid + 16u];
            uint out_j0 = p_idx * 2u;
            y_out[out_j0] += total.x;
            y_out[out_j0 + 1u] += total.y;
        }
    }
}
