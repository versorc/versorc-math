layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConstants {
    uint num_elements;
    uint _pad0;
    uint _pad1;
    uint _pad2;
} pc;

layout(std430, binding = 0) readonly buffer GateBuffer {
    float gate[];
};

layout(std430, binding = 1) readonly buffer UpBuffer {
    float up[];
};

layout(std430, binding = 2) writeonly buffer OutputBuffer {
    float act[];
};

float silu(float x) {
    return x / (1.0 + exp(-x));
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx < pc.num_elements) {
        act[idx] = silu(gate[idx]) * up[idx];
    }
}
